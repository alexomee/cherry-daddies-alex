Dialogue: 0,0:00:00.00,0:03:41.33,Title,,0,0,0,,Я сошла с ума
Dialogue: 0,0:00:12.34,0:00:19.33,Pair,,0,0,0,,Я сошла с ума\NЯ сошла с ума
Dialogue: 0,0:00:19.33,0:00:21.33,Pair,,0,0,0,,Мне нужна она\NМне нужна она
Dialogue: 0,0:00:21.33,0:00:23.67,Pair,,0,0,0,,Мне нужна она\NЯ сошла с ума
Dialogue: 0,0:00:23.67,0:00:25.67,Pair,,0,0,0,,Я сошла с ума\NМне нужна она
Dialogue: 0,0:00:25.67,0:00:27.99,Pair,,0,0,0,,Мне нужна она\NМне нужна она
Dialogue: 0,0:00:27.99,0:00:38.34,Pair,,0,0,0,,Я сошла с ума
Dialogue: 0,0:00:38.34,0:00:41.01,Pair,,0,0,0,,Меня полностью нет\NАбсолютно всерьёз
Dialogue: 0,0:00:41.01,0:00:43.67,Pair,,0,0,0,,Ситуация HELP\NСитуация SOS
Dialogue: 0,0:00:43.67,0:00:46.34,Pair,,0,0,0,,Я себя не пойму\NТы откуда взялась?
Dialogue: 0,0:00:46.34,0:00:49.01,Pair,,0,0,0,,Почему, почему\NНа тебя повелась?
Dialogue: 0,0:00:49.01,0:00:51.67,Pair,,0,0,0,,Выключается свет\NЯ куда-то лечу
Dialogue: 0,0:00:51.67,0:00:54.34,Pair,,0,0,0,,Без тебя меня нет\NНичего не хочу
Dialogue: 0,0:00:54.34,0:00:57.01,Pair,,0,0,0,,Это медленный яд\NЭто сводит с ума
Dialogue: 0,0:00:57.01,0:01:02.67,Pair,,0,0,0,,А они говорят "Виновата сама"\NА они говорят "Виновата сама"
Dialogue: 0,0:01:02.67,0:01:04.66,Pair,,0,0,0,,Я сошла с ума\NЯ сошла с ума
Dialogue: 0,0:01:04.66,0:01:06.67,Pair,,0,0,0,,Мне нужна она\NМне нужна она
Dialogue: 0,0:01:06.67,0:01:09.00,Pair,,0,0,0,,Мне нужна она\NЯ сошла с ума
Dialogue: 0,0:01:09.00,0:01:11.00,Pair,,0,0,0,,Я сошла с ума\NМне нужна она
Dialogue: 0,0:01:11.00,0:01:13.33,Pair,,0,0,0,,Мне нужна она\NМне нужна она
Dialogue: 0,0:01:13.33,0:01:18.67,Pair,,0,0,0,,Я сошла с ума\NЯ сошла с ума, ума
Dialogue: 0,0:01:18.67,0:01:23.01,Pair,,0,0,0,,Мне нужна она\NМне нужна она
Dialogue: 0,0:01:23.01,0:01:25.34,Pair,,0,0,0,,Мне нужна она\NМне нужна она
Dialogue: 0,0:01:25.34,0:01:27.67,Pair,,0,0,0,,Мне нужна она\NМне нужна она
Dialogue: 0,0:01:27.67,0:01:50.34,Pair,,0,0,0,,Мне нужна она\NМне нужна она
Dialogue: 0,0:01:50.34,0:01:53.01,Pair,,0,0,0,,Без тебя я не я\NБез тебя меня нет
Dialogue: 0,0:01:53.01,0:01:55.67,Pair,,0,0,0,,А они говорят\NГоворят "Это бред"
Dialogue: 0,0:01:55.67,0:01:58.34,Pair,,0,0,0,,Это солнечный яд\NЗолотые лучи
Dialogue: 0,0:01:58.34,0:02:02.34,Pair,,0,0,0,,А они говорят "Надо срочно лечить\NЯ хотела забыть
Dialogue: 0,0:02:02.34,0:02:05.01,Pair,,0,0,0,,До упора их лиц\NЯ считала столбы
Dialogue: 0,0:02:05.01,0:02:07.67,Pair,,0,0,0,,И растерянных птиц\NБез тебя меня нет
Dialogue: 0,0:02:07.67,0:02:10.34,Pair,,0,0,0,,Отпусти, отпусти\NДо угла по стене
Dialogue: 0,0:02:10.34,0:02:13.00,Pair,,0,0,0,,Мама, папа, прости\NЯ сошла с ума
Dialogue: 0,0:02:13.00,0:02:15.01,Pair,,0,0,0,,Я сошла с ума\NМне нужна она
Dialogue: 0,0:02:15.01,0:02:17.34,Pair,,0,0,0,,Мне нужна она\NМне нужна она
Dialogue: 0,0:02:17.34,0:02:19.34,Pair,,0,0,0,,Я сошла с ума\NЯ сошла с ума
